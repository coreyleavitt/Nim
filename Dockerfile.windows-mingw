# escape=`
# Windows toolchain env, mingw edition — patched Nim 2.2.10 built with and
# driving mingw-w64 gcc (winlibs), on Windows Server Core. Complements the
# MSVC image (Dockerfile): same backport series, different C toolchain. This
# is the higher-fidelity variant for matching upstream: Nim's official
# Windows zips are mingw-built, so most Windows Nim users run this toolchain.
# Series: patches/2.2.10/ (synced from the WSL toolchain — that copy is the
# source of truth); list and rationale in the MSVC Dockerfile.
#
# Standalone tag only: this image is windows/amd64 exactly like the MSVC one,
# and the ghcr.io/coreyleavitt/nim:2.2.10 manifest list already carries a
# windows/amd64 entry, so this ships as :2.2.10-mingw and is never stitched
# (same reasoning as :2.2.10-alpine vs the glibc linux entry).
#
# Single stage, unlike the MSVC image: the toolchain IS the runtime here
# (nim drives gcc on every compile), so there is nothing to trim away.
#
# Requires Docker Desktop in "Windows containers" mode. Build (-m 16g — the
# Hyper-V isolation default of 1 GB OOM-kills release-mode compiles):
#   docker build -m 16g -f Dockerfile.mingw -t ghcr.io/coreyleavitt/nim:2.2.10-mingw .
#   docker push ghcr.io/coreyleavitt/nim:2.2.10-mingw
# Run:
#   docker run --rm -v C:\Users\corey\projects\oyamel:C:\app ghcr.io/coreyleavitt/nim:2.2.10-mingw nimble test
# Stock compiler for comparison: C:\nim\2.2.10-stock\bin\nim.exe (also mingw)

FROM mcr.microsoft.com/windows/servercore:ltsc2025

SHELL ["powershell", "-Command", "$ErrorActionPreference = 'Stop'; $ProgressPreference = 'SilentlyContinue';"]

# Git first: nimble fetches packages with it, and build-nim.ps1 applies the
# backport series with `git apply` (no GNU patch on Windows).
RUN Invoke-WebRequest -Uri https://github.com/git-for-windows/git/releases/download/v2.47.1.windows.2/MinGit-2.47.1.2-64-bit.zip -OutFile git.zip; `
    Expand-Archive git.zip -DestinationPath C:\git; `
    Remove-Item -Force git.zip

# mingw-w64 gcc 16.1.0 (winlibs: UCRT runtime, posix threads, SEH), pinned to
# the release checksum. Extracts to C:\mingw64.
RUN Invoke-WebRequest -Uri https://github.com/brechtsanders/winlibs_mingw/releases/download/16.1.0posix-14.0.0-ucrt-r4/winlibs-x86_64-posix-seh-gcc-16.1.0-mingw-w64ucrt-14.0.0-r4.zip -OutFile winlibs.zip; `
    $h = (Get-FileHash -Algorithm SHA256 winlibs.zip).Hash.ToLowerInvariant(); `
    if ($h -ne 'c406a22f8cac82559a3a1d96b62ff603f666499fb5ff4784e87b4eb6fa37dede') { throw ('winlibs.zip sha256 mismatch: ' + $h) }; `
    Expand-Archive winlibs.zip -DestinationPath C:\; `
    Remove-Item -Force winlibs.zip

# Stock Nim 2.2.10 (pinned): the pristine comparison compiler AND the stage-0
# bootstrap for the patched source build. Its default cc (gcc) is exactly
# right here, so unlike the MSVC image nothing is appended to its nim.cfg.
RUN Invoke-WebRequest -Uri https://nim-lang.org/download/nim-2.2.10_x64.zip -OutFile nim.zip; `
    $h = (Get-FileHash -Algorithm SHA256 nim.zip).Hash.ToLowerInvariant(); `
    if ($h -ne 'fe0686a9b298e5b13d0a983df37e002a8c6320f8b16cc45a51d15cf4046a109f') { throw ('nim.zip sha256 mismatch: ' + $h) }; `
    Expand-Archive nim.zip -DestinationPath C:\; `
    New-Item -ItemType Directory -Path C:\nim -Force | Out-Null; `
    Move-Item C:\nim-2.2.10 C:\nim\2.2.10-stock; `
    Remove-Item -Force nim.zip

RUN New-Item -ItemType Directory -Path C:\Users\ContainerAdministrator\.nimble\bin -Force | Out-Null

# Patched compiler first on PATH; stock stays off PATH, reachable by full
# path only. mingw at the end so nim, git and nimble shims win name clashes.
RUN $p = 'C:\nim\2.2.10-patched\bin;C:\git\cmd;C:\Users\ContainerAdministrator\.nimble\bin;C:\mingw64\bin;' + [Environment]::GetEnvironmentVariable('PATH', 'Machine'); `
    [Environment]::SetEnvironmentVariable('PATH', $p, 'Machine')

# Trust the host-mounted repo (nimble shells out to git for VCS metadata,
# which refuses on cross-user-owned dirs by default).
RUN git config --global --add safe.directory C:/app

# Build patched 2.2.10 with gcc — last, because the patch series changes most
# often and everything above stays cached.
COPY build-nim.ps1 C:\build-nim.ps1
COPY patches C:\nim-patches
# Pre-seeded release tarball (sha-verified by build-nim.ps1): container NAT
# lacks an IPv6 path and nim-lang.org resolves to IPv6 in-container, so the
# in-build download times out. The cache hit skips the download entirely.
COPY cache C:\tarball-cache
ENV TARBALL_CACHE=C:\tarball-cache
RUN powershell -File C:\build-nim.ps1 -Version 2.2.10 `
        -Sha256 7957b7ed004206bcf10bcc4f3b4744153878e62f2431552a9a8e9d3f40e8d5d5 `
        -Prefix C:\nim\2.2.10-patched `
        -Bootstrap C:\nim\2.2.10-stock `
        -PatchDir C:\nim-patches\2.2.10 `
        -KochTools -CC gcc

LABEL org.opencontainers.image.title="Nim (patched dev base, Windows/mingw)" `
      org.opencontainers.image.description="Nim 2.2.10 + backport series (#25855, #25858, #26093, #26017, #26110, #26076), nimble + tools, mingw-w64 gcc (winlibs) on Windows Server Core" `
      org.opencontainers.image.base.name="mcr.microsoft.com/windows/servercore:ltsc2025" `
      dev.leavitt.nim.version="2.2.10" `
      dev.leavitt.nim.patches="nim-lang/Nim#25855,nim-lang/Nim#25858,nim-lang/Nim#26093,nim-lang/Nim#26017,nim-lang/Nim#26110,nim-lang/Nim#26076"

WORKDIR C:\app

CMD ["powershell"]
